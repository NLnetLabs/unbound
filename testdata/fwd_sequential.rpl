; config options
server:
	minimal-responses: no

forward-zone:
	name: "."
	forward-sequential: yes
	forward-addr: 10.0.0.1
	forward-addr: 10.0.0.2
CONFIG_END

SCENARIO_BEGIN Test forward-sequential uses the first forwarder, fails over to the next

; the first configured forwarder, it does not answer b.example.com.
RANGE_BEGIN 0 100
	ADDRESS 10.0.0.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
a.example.com. IN A
SECTION ANSWER
a.example.com. IN A 10.20.30.1
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
c.example.com. IN A
SECTION ANSWER
c.example.com. IN A 10.20.30.1
ENTRY_END
RANGE_END

; the second configured forwarder
RANGE_BEGIN 0 100
	ADDRESS 10.0.0.2
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
a.example.com. IN A
SECTION ANSWER
a.example.com. IN A 10.20.30.2
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
b.example.com. IN A
SECTION ANSWER
b.example.com. IN A 10.20.30.2
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
c.example.com. IN A
SECTION ANSWER
c.example.com. IN A 10.20.30.2
ENTRY_END
RANGE_END

; the second forwarder is much faster, outside of the rtt band, so
; without forward-sequential it would always be selected.
STEP 1 INFRA_RTT 10.0.0.1 . 1000
STEP 2 INFRA_RTT 10.0.0.2 . 10

; the first forwarder is used, even though it is slower
STEP 10 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
a.example.com. IN A
ENTRY_END

STEP 20 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
a.example.com. IN A
SECTION ANSWER
a.example.com. IN A 10.20.30.1
ENTRY_END

; the first forwarder times out, the query fails over to the second
STEP 30 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
b.example.com. IN A
ENTRY_END

STEP 31 TIMEOUT

STEP 40 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
b.example.com. IN A
SECTION ANSWER
b.example.com. IN A 10.20.30.2
ENTRY_END

; the next query goes to the first forwarder again
STEP 50 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
c.example.com. IN A
ENTRY_END

STEP 60 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
c.example.com. IN A
SECTION ANSWER
c.example.com. IN A 10.20.30.1
ENTRY_END

SCENARIO_END
