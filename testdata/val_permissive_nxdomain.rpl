; config options
server:
	; This is the test key 29332 in the testdata.
	trust-anchor: ". 3600 IN DS 29332 8 2 b75e26316631b6e37cbc977323a08769f86e36a10fee888676d35f61e2ff4181"
	val-override-date: "20201020135527"
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	fake-sha1: yes
	trust-anchor-signaling: no
	minimal-responses: no
	log-servfail: yes
	; The option under test: a bogus NXDOMAIN reaches the client.
	val-permissive-nxdomain: yes

forward-zone:
	name: "."
	forward-addr: 10.5.5.5
CONFIG_END

SCENARIO_BEGIN val-permissive-nxdomain: a bogus NXDOMAIN is let through, and
; nothing else is. The forwarding upstream answers unsigned, so every response
; below validates as bogus: the DS lookup for veryinvalid. returns an NSEC that
; does not cover the name asked for, so the validator can establish neither a
; secure nor an insecure delegation for it.
;
; Three queries, one mock:
;   TXT  a bogus NXDOMAIN  -> NXDOMAIN   (this option fires)
;   A    a bogus NODATA    -> SERVFAIL   (val-permissive-nodata is off)
;   A    a bogus POSITIVE  -> SERVFAIL   (neither option may ever fire)

; 10.5.5.5 forwarder
RANGE_BEGIN 0 100
	ADDRESS 10.5.5.5

; NXDOMAIN, unsigned, from the upstream.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
example.veryinvalid. IN TXT
SECTION AUTHORITY
. 3600 IN SOA ns.root. host.root. 1 3600 3600 3600 3600
ENTRY_END

; NODATA, unsigned, from the upstream.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NOERROR
SECTION QUESTION
example.veryinvalid. IN A
SECTION AUTHORITY
. 3600 IN SOA ns.root. host.root. 1 3600 3600 3600 3600
ENTRY_END

; A positive answer, unsigned, from the upstream.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NOERROR
SECTION QUESTION
positive.veryinvalid. IN A
SECTION ANSWER
positive.veryinvalid. 3600 IN A 192.0.2.1
SECTION AUTHORITY
. 3600 IN SOA ns.root. host.root. 1 3600 3600 3600 3600
ENTRY_END

; A CNAME chain ending in NXDOMAIN, as a filtering forwarder returns it: the
; whole chain in one response, carrying the negative rcode. This classifies as
; VAL_CLASS_CNAMENOANSWER rather than NAMEERROR, so it exercises the rcode
; disambiguation.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
chain.veryinvalid. IN A
SECTION ANSWER
chain.veryinvalid. 3600 IN CNAME example.veryinvalid.
SECTION AUTHORITY
. 3600 IN SOA ns.root. host.root. 1 3600 3600 3600 3600
ENTRY_END

; DNSKEY answer, using CSK for test simplicity.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NOERROR
SECTION QUESTION
. IN DNSKEY
SECTION ANSWER
.       IN      DNSKEY  257 3 8  ;{id = 29332 (ksk), size = 2048b}
.	3600	IN	RRSIG	DNSKEY 8 0 3600 20201116135527 20201019135527 29332 . 
ENTRY_END

; answer for DS, unsigned NSEC that does not cover the name.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
veryinvalid. IN DS
SECTION AUTHORITY
versicherung.	3600	IN	NSEC	vet. NS DS RRSIG NSEC
versicherung.	3600	IN	RRSIG	NSEC 8 1 3600 20201116135527 20201019135527 29332 . 
.	3600	IN	NSEC	aaa. NS SOA RRSIG NSEC DNSKEY ZONEMD
.	3600	IN	RRSIG	NSEC 8 0 3600 20201116135527 20201019135527 29332 . 
.	3600	IN	SOA	ns.root. host.root. 1 3600 3600 3600 3600
.	3600	IN	RRSIG	SOA 8 0 3600 20201116135527 20201019135527 29332 . 
ENTRY_END
RANGE_END

; The option fires: a bogus NXDOMAIN is served, not SERVFAIL.
STEP 1 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
example.veryinvalid. IN TXT
ENTRY_END

STEP 10 CHECK_ANSWER
ENTRY_BEGIN
MATCH rcode
REPLY QR RD RA DO NXDOMAIN
SECTION QUESTION
example.veryinvalid. IN TXT
ENTRY_END

; It does not leak into NODATA.
STEP 20 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
example.veryinvalid. IN A
ENTRY_END

STEP 30 CHECK_ANSWER
ENTRY_BEGIN
MATCH rcode
REPLY QR RD RA DO SERVFAIL
SECTION QUESTION
example.veryinvalid. IN A
ENTRY_END

; It does not leak into a positive answer. This is the security property that
; separates the scoped options from val-permissive-mode: a name resolved to an
; address the signer never published is still withheld.
STEP 40 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
positive.veryinvalid. IN A
ENTRY_END

STEP 50 CHECK_ANSWER
ENTRY_BEGIN
MATCH rcode
REPLY QR RD RA DO SERVFAIL
SECTION QUESTION
positive.veryinvalid. IN A
ENTRY_END

; A CNAME chain that ended in NXDOMAIN is NOT covered, and must stay SERVFAIL.
; By the time the validator classifies the message it has already rewritten the
; rcode to NOERROR (it arrives as VAL_CLASS_CNAME), so at the point this option
; is applied a chain ending in NXDOMAIN is indistinguishable from one ending in
; NODATA. Widening the gate to VAL_CLASS_CNAME would admit a bogus positive
; chain, which is the protection this option exists to keep. Pinned here so the
; gap cannot change silently.
STEP 60 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
chain.veryinvalid. IN A
ENTRY_END

STEP 70 CHECK_ANSWER
ENTRY_BEGIN
MATCH rcode
REPLY QR RD RA DO SERVFAIL
SECTION QUESTION
chain.veryinvalid. IN A
ENTRY_END

SCENARIO_END
