; config options
server:
	; This is the test key 29332 in the testdata.
	trust-anchor: ". 3600 IN DS 29332 8 2 b75e26316631b6e37cbc977323a08769f86e36a10fee888676d35f61e2ff4181"
	val-override-date: "20201020135527"
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	fake-sha1: yes
	trust-anchor-signaling: no
	minimal-responses: no
	log-servfail: yes
	; The option under test: a bogus NXDOMAIN reaches the client.
	val-permissive-nxdomain: yes

forward-zone:
	name: "."
	forward-addr: 10.5.5.5
CONFIG_END

SCENARIO_BEGIN val-permissive-nxdomain: a bogus NXDOMAIN is let through, and
; nothing else is. The forwarding upstream answers unsigned, so every response
; below validates as bogus: the DS lookup for veryinvalid. returns an NSEC that
; does not cover the name asked for, so the validator can establish neither a
; secure nor an insecure delegation for it.
;
; Three queries, one mock:
;   TXT  a bogus NXDOMAIN  -> NXDOMAIN   (this option fires)
;   A    a bogus NODATA    -> SERVFAIL   (val-permissive-nodata is off)
;   A    a bogus POSITIVE  -> SERVFAIL   (neither option may ever fire)

; 10.5.5.5 forwarder
RANGE_BEGIN 0 1000
	ADDRESS 10.5.5.5

; NXDOMAIN, unsigned, from the upstream.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
example.veryinvalid. IN TXT
SECTION AUTHORITY
ENTRY_END

; NODATA, unsigned, from the upstream.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NOERROR
SECTION QUESTION
example.veryinvalid. IN A
SECTION AUTHORITY
ENTRY_END

; A positive answer, unsigned, from the upstream.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NOERROR
SECTION QUESTION
positive.veryinvalid. IN A
SECTION ANSWER
positive.veryinvalid. 3600 IN A 192.0.2.1
SECTION AUTHORITY
. 3600 IN SOA ns.root. host.root. 1 3600 3600 3600 3600
ENTRY_END

; A chain that runs out of answer section and ends in NXDOMAIN. The chain itself
; is one query and the negative is another, so the message the validator ends up
; with is a CNAME chain whose last hop is a NAMEERROR -- VAL_CLASS_CNAMENOANSWER,
; which is why it needs the rcode to say which scoped option it belongs to.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NOERROR
SECTION QUESTION
chain.veryinvalid. IN A
SECTION ANSWER
chain.veryinvalid. 3600 IN CNAME target.veryinvalid.
ENTRY_END

; ...and the target it points at does not exist.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
target.veryinvalid. IN A
SECTION AUTHORITY
. 3600 IN SOA ns.root. host.root. 1 3600 3600 3600 3600
ENTRY_END

; A forged negative that carries records the signer never published in its
; AUTHORITY section. The validator does not vouch for that section and Unbound
; encodes it as received, so admitting any negative would let it smuggle an
; MX or TXT of the sender's choosing into the client's answer and the cache.
; This must stay SERVFAIL.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
smuggle.veryinvalid. IN A
SECTION AUTHORITY
. 3600 IN SOA ns.root. host.root. 1 3600 3600 3600 3600
smuggle.veryinvalid. 3600 IN TXT "forged-dmarc-v=DMARC1; p=none"
smuggle.veryinvalid. 3600 IN MX 10 forged.example.
ENTRY_END

; A forged negative whose AUTHORITY holds ONE record of a type that is not an
; SOA. The section is not validated and Unbound carries it as received, so
; admitting it would let the sender put a TXT, MX or CAA of its choosing into
; the client's answer and the cache. This must stay SERVFAIL - and it is why
; the gate checks the TYPE of the single authority RRset, not merely its count.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
onlytxt.veryinvalid. IN A
SECTION AUTHORITY
onlytxt.veryinvalid. 3600 IN TXT "forged-only-txt"
ENTRY_END

; A forged NXDOMAIN with NO authority section at all: the shape a filtering
; resolver actually sends (ANSWER: 0, AUTHORITY: 0).
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
zeroauth.veryinvalid. IN A
ENTRY_END

; A forged negative carrying an UNSIGNED SOA. The type looks benign, but the
; section is not validated and Unbound carries it as received -- so it reaches
; the client, sets its negative-cache TTL, and lands in the rrset cache. Must
; stay SERVFAIL.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
withsoa.veryinvalid. IN A
SECTION AUTHORITY
. 604800 IN SOA ns.evil.example. host.evil.example. 1 604800 604800 604800 604800
ENTRY_END

; DNSKEY answer, using CSK for test simplicity.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NOERROR
SECTION QUESTION
. IN DNSKEY
SECTION ANSWER
.       IN      DNSKEY  257 3 8  ;{id = 29332 (ksk), size = 2048b}
.	3600	IN	RRSIG	DNSKEY 8 0 3600 20201116135527 20201019135527 29332 . 
ENTRY_END

; answer for DS, unsigned NSEC that does not cover the name.
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NXDOMAIN
SECTION QUESTION
veryinvalid. IN DS
SECTION AUTHORITY
versicherung.	3600	IN	NSEC	vet. NS DS RRSIG NSEC
versicherung.	3600	IN	RRSIG	NSEC 8 1 3600 20201116135527 20201019135527 29332 . 
.	3600	IN	NSEC	aaa. NS SOA RRSIG NSEC DNSKEY ZONEMD
.	3600	IN	RRSIG	NSEC 8 0 3600 20201116135527 20201019135527 29332 . 
.	3600	IN	SOA	ns.root. host.root. 1 3600 3600 3600 3600
.	3600	IN	RRSIG	SOA 8 0 3600 20201116135527 20201019135527 29332 . 
ENTRY_END
RANGE_END

; The option fires: a bogus NXDOMAIN is served, not SERVFAIL.
STEP 1 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
example.veryinvalid. IN TXT
ENTRY_END

STEP 10 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NXDOMAIN
SECTION QUESTION
example.veryinvalid. IN TXT
SECTION ANSWER
SECTION AUTHORITY
SECTION ADDITIONAL
. 32768 CLASS1232 OPT \# 00
ENTRY_END

; It does not leak into NODATA.
STEP 20 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
example.veryinvalid. IN A
ENTRY_END

STEP 30 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA SERVFAIL
SECTION QUESTION
example.veryinvalid. IN A
SECTION ANSWER
SECTION AUTHORITY
SECTION ADDITIONAL
. 32768 CLASS1232 OPT \# 00
ENTRY_END

; It does not leak into a positive answer. This is the security property that
; separates the scoped options from val-permissive-mode: a name resolved to an
; address the signer never published is still withheld.
STEP 40 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
positive.veryinvalid. IN A
ENTRY_END

STEP 50 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA SERVFAIL
SECTION QUESTION
positive.veryinvalid. IN A
SECTION ANSWER
SECTION AUTHORITY
SECTION ADDITIONAL
. 32768 CLASS1232 OPT \# 00
ENTRY_END

; A CNAME chain that ended in NXDOMAIN IS covered - but only when its own links
; are authenticated, because the chain is served to the client and admitting a
; forged one would be handing over a redirection. Here the whole zone is bogus,
; so the chain link is not secure and the message must stay SERVFAIL. That is
; the security half of the rule; the fixture that exercises the admitting half,
; where the chain is signed and only the denial is unproven, is
; testdata/val_permissive_cnamechain.rpl.
STEP 60 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
chain.veryinvalid. IN A
ENTRY_END

STEP 70 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA SERVFAIL
SECTION QUESTION
chain.veryinvalid. IN A
SECTION ANSWER
SECTION AUTHORITY
SECTION ADDITIONAL
. 32768 CLASS1232 OPT \# 00
ENTRY_END

; And a negative padded with unvalidated records is refused outright.
STEP 80 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
smuggle.veryinvalid. IN A
ENTRY_END

STEP 90 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA SERVFAIL
SECTION QUESTION
smuggle.veryinvalid. IN A
SECTION ANSWER
SECTION AUTHORITY
SECTION ADDITIONAL
. 32768 CLASS1232 OPT \# 00
ENTRY_END

; One non-SOA authority record is refused: checking the COUNT alone would let
; this through.
STEP 91 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
onlytxt.veryinvalid. IN A
ENTRY_END

STEP 92 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA SERVFAIL
SECTION QUESTION
onlytxt.veryinvalid. IN A
SECTION ANSWER
SECTION AUTHORITY
SECTION ADDITIONAL
. 32768 CLASS1232 OPT \# 00
ENTRY_END

; The bare shape must be SERVED - this is the shape a filtering resolver sends.
; NOTE step numbers must stay within the mock's RANGE_END (100): RANGE_BEGIN is
; a time window and the STEP number is the clock, so a step past it finds the
; mock gone and dies with "query answer not matched".
STEP 93 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
zeroauth.veryinvalid. IN A
ENTRY_END

STEP 94 CHECK_ANSWER
ENTRY_BEGIN
MATCH rcode
REPLY QR RD RA DO NXDOMAIN
SECTION QUESTION
zeroauth.veryinvalid. IN A
ENTRY_END

; An unsigned SOA in authority is refused like any other smuggled record.
STEP 95 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
withsoa.veryinvalid. IN A
ENTRY_END

STEP 96 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA SERVFAIL
SECTION QUESTION
withsoa.veryinvalid. IN A
SECTION ANSWER
SECTION AUTHORITY
SECTION ADDITIONAL
. 32768 CLASS1232 OPT \# 00
ENTRY_END

SCENARIO_END
