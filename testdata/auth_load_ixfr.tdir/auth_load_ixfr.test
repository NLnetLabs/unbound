# #-- auth_load_ixfr.test --#
# source the master var file when it's there
[ -f ../.tpkg.var.master ] && source ../.tpkg.var.master
# use .tpkg.var.test for in test variable passing
[ -f .tpkg.var.test ] && source .tpkg.var.test

PRE="../.."
. ../common.sh
# do the test

$PRE/streamtcp -f 127.0.0.1@$UNBOUND_PORT rpz.example.com. NOTIFY IN

wait_logfile unbound.log "auth zone rpz.example.com. updated to serial 2" 10

# The answer is rewritten by RPZ, that is loaded in the auth load thread.
echo "> dig www.example.com."
dig @127.0.0.1 -p $UNBOUND_PORT www.example.com. | tee outfile
if grep SERVFAIL outfile; then
	echo "> try again"
	dig @127.0.0.1 -p $UNBOUND_PORT www.example.com. | tee outfile
fi
if grep SERVFAIL outfile; then
	echo "> try again"
	sleep 1
	dig @127.0.0.1 -p $UNBOUND_PORT www.example.com. | tee outfile
fi
if grep SERVFAIL outfile; then
	echo "> try again"
	sleep 1
	dig @127.0.0.1 -p $UNBOUND_PORT www.example.com. | tee outfile
fi
if grep SERVFAIL outfile; then
	echo "> try again"
	sleep 1
	dig @127.0.0.1 -p $UNBOUND_PORT www.example.com. | tee outfile
fi
if grep SERVFAIL outfile; then
	echo "> try again"
	sleep 3
	dig @127.0.0.1 -p $UNBOUND_PORT www.example.com. | tee outfile
fi
if grep SERVFAIL outfile; then
	echo "> try again"
	sleep 3
	dig @127.0.0.1 -p $UNBOUND_PORT www.example.com. | tee outfile
fi
echo "> check answer"
if grep "1.2.3.5" outfile; then
	echo "OK"
else
	echo "Not OK"
	exit 1
fi

echo "> dig o3.example.com."
dig @127.0.0.1 -p $UNBOUND_PORT o3.example.com. | tee outfile
echo "> check answer"
if grep "1.2.3.7" outfile; then
	echo "OK"
else
	echo "Not OK"
	exit 1
fi

echo "> dig other.example.com."
dig @127.0.0.1 -p $UNBOUND_PORT other.example.com. | tee outfile
echo "> check answer"
if grep "10.20.30.40" outfile; then
	echo "OK"
else
	echo "Not OK"
	exit 1
fi

if grep "auth zone rpz.example.com. details" unbound.log; then
	echo "OK"
else
	echo "not OK"
	exit 1
fi

# wait_logfile
wait_logfile unbound.log "write zonefile auth_load_ixfr.zone for rpz.example.com." 10
echo ""
echo "> auth_load_ixfr.zone"
cat auth_load_ixfr.zone

exit 0
