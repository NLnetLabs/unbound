; nameserver test file
$ORIGIN example.
$TTL 3600

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
tagged	IN	AAAA
SECTION ANSWER
; NO AAAA present
SECTION AUTHORITY
example.	IN	SOA	ns.example. hostmaster.example. 1 2 3 4 5
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
tagged	IN	A
SECTION ANSWER
tagged	IN	A	192.0.2.1
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
untagged	IN	AAAA
SECTION ANSWER
; NO AAAA present
SECTION AUTHORITY
example.	IN	SOA	ns.example. hostmaster.example. 1 2 3 4 5
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
untagged	IN	A
SECTION ANSWER
untagged	IN	A	192.0.2.2
ENTRY_END
