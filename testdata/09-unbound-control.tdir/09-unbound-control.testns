; nameserver test file
$TTL 3600

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
www.example.com.	IN	A
SECTION ANSWER
www.example.com.	IN	A	10.20.30.40
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
example.com.	IN	SOA
SECTION ANSWER
example.com.	IN	SOA	ns.example.com. root.example.com. 1 2 3 4 5
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
example.com.	IN	DS
SECTION ANSWER
example.com.	IN	DS	55555 8 2 1234567890123456789012345678901234567890123456789012345678901234
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
example.com.	IN	CDS
SECTION ANSWER
example.com.	IN	CDS	55555 8 2 1234567890123456789012345678901234567890123456789012345678901234
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
example.com.	IN	CDNSKEY
SECTION ANSWER
example.com.	IN	CDNSKEY	257 3 8 AwEAAQ==
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
example.com.	IN	CSYNC
SECTION ANSWER
example.com.	IN	CSYNC	1 3 A NS AAAA
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
example.com.	IN	NSEC
SECTION ANSWER
example.com.	IN	NSEC	www.example.com. NS SOA RRSIG NSEC DNSKEY
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
example.com.	IN	DNAME
SECTION ANSWER
example.com.	IN	DNAME	example.net.
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NXDOMAIN
ADJUST copy_id
SECTION QUESTION
new.example.com.	IN	A
SECTION AUTHORITY
example.com.	IN	SOA	ns.example.com. root.example.com. 1 2 3 4 3600
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NXDOMAIN
ADJUST copy_id
SECTION QUESTION
new.example.com.	IN	AAAA
SECTION AUTHORITY
example.com.	IN	SOA	ns.example.com. root.example.com. 1 2 3 4 3600
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA SERVFAIL
ADJUST copy_id
SECTION QUESTION
www.example.net.	IN	A
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
always.empty.	IN	A
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
always.empty.	IN	DNSKEY
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QR AA NOERROR
ADJUST copy_id
SECTION QUESTION
_ta-c5aa.always.empty.	IN	NULL
ENTRY_END
