; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: "no"
	minimal-responses: no
	iter-scrub-promiscuous: no
	prefetch: yes

	access-control: 10.10.10.0/24 allow
	access-control-view: 10.10.10.10/32 "m-a"
	access-control-view: 10.10.10.20/32 "m"
	access-control-view: 10.10.10.30/32 "v-fallback"
	access-control-view: 10.10.10.40/32 "v-nofallback"

forward-zone:
	name: "."
	forward-addr: 216.0.0.3

view:
	name: "m-a"
	forward-zone:
		name: "."
		forward-addr: 216.0.0.1

view:
	name: "m"
	forward-zone:
		name: "."
		forward-addr: 216.0.0.2

view:
	name: "v-fallback"
	view-first: yes
	forward-zone:
		name: "corp.example.com."
		forward-addr: 216.0.0.4

view:
	name: "v-nofallback"
	view-first: no
	forward-zone:
		name: "corp.example.com."
		forward-addr: 216.0.0.4

stub-zone:
	name: "."
	stub-addr: 216.0.0.5

CONFIG_END

SCENARIO_BEGIN Test view specific forward-zone resolution

; Server 216.0.0.1 (view m-a upstream, initial)
RANGE_BEGIN 0 3499
	ADDRESS 216.0.0.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
a.example.com. IN A
SECTION ANSWER
a.example.com. IN A 10.1.1.1
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
shared.example.com. IN A
SECTION ANSWER
shared.example.com. IN A 10.1.1.99
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
prefetch.example.com. IN A
SECTION ANSWER
prefetch.example.com. 3600 IN A 10.1.1.55
ENTRY_END
RANGE_END

; Server 216.0.0.1 (view m-a upstream, after prefetch)
RANGE_BEGIN 3500 4000
	ADDRESS 216.0.0.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
shared.example.com. IN A
SECTION ANSWER
shared.example.com. IN A 10.1.1.99
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
prefetch.example.com. IN A
SECTION ANSWER
prefetch.example.com. 3600 IN A 10.1.1.56
ENTRY_END
RANGE_END

; Server 216.0.0.2 (view m upstream)
RANGE_BEGIN 0 4000
	ADDRESS 216.0.0.2
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
b.example.com. IN A
SECTION ANSWER
b.example.com. IN A 10.2.2.2
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
shared.example.com. IN A
SECTION ANSWER
shared.example.com. IN A 10.2.2.99
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
prefetch.example.com. IN A
SECTION ANSWER
prefetch.example.com. 3600 IN A 10.2.2.55
ENTRY_END
RANGE_END

; Server 216.0.0.3 (global forwarder)
RANGE_BEGIN 0 4000
	ADDRESS 216.0.0.3
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
c.example.com. IN A
SECTION ANSWER
c.example.com. IN A 10.3.3.3
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
fallback.example.com. IN A
SECTION ANSWER
fallback.example.com. IN A 10.3.3.4
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
shared.example.com. IN A
SECTION ANSWER
shared.example.com. IN A 10.3.3.99
ENTRY_END
RANGE_END

; Server 216.0.0.4 (corp zone in v-fallback / v-nofallback)
RANGE_BEGIN 0 4000
	ADDRESS 216.0.0.4
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
host.corp.example.com. IN A
SECTION ANSWER
host.corp.example.com. IN A 10.4.4.4
ENTRY_END
RANGE_END

; Server 216.0.0.5 (stub root for fallback when no forwarder is used)
RANGE_BEGIN 0 4000
	ADDRESS 216.0.0.5
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
. IN NS
SECTION ANSWER
. IN NS ns.root.
SECTION ADDITIONAL
ns.root. IN A 216.0.0.5
ENTRY_END

ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
fallback.example.com. IN A
SECTION ANSWER
fallback.example.com. 3600 IN A 10.5.5.5
ENTRY_END
RANGE_END

; Test 1: Query from client in view m-a (10.10.10.10)
STEP 1 QUERY ADDRESS 10.10.10.10
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
a.example.com. IN A
ENTRY_END

STEP 10 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
a.example.com. IN A
SECTION ANSWER
a.example.com. IN A 10.1.1.1
ENTRY_END

; Test 2: Query from client in view m (10.10.10.20)
STEP 20 QUERY ADDRESS 10.10.10.20
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
b.example.com. IN A
ENTRY_END

STEP 30 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
b.example.com. IN A
SECTION ANSWER
b.example.com. IN A 10.2.2.2
ENTRY_END

; Test 3: Query from client not in any view (10.10.10.50) using global forwarder
STEP 40 QUERY ADDRESS 10.10.10.50
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
c.example.com. IN A
ENTRY_END

STEP 50 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
c.example.com. IN A
SECTION ANSWER
c.example.com. IN A 10.3.3.3
ENTRY_END

; Test 4: Query matching view forwarder in v-fallback (10.10.10.30)
STEP 60 QUERY ADDRESS 10.10.10.30
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
host.corp.example.com. IN A
ENTRY_END

STEP 70 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
host.corp.example.com. IN A
SECTION ANSWER
host.corp.example.com. IN A 10.4.4.4
ENTRY_END

; Test 5: Query not matching view forwarder in v-fallback (10.10.10.30), falling back to global forwarder
STEP 80 QUERY ADDRESS 10.10.10.30
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
fallback.example.com. IN A
ENTRY_END

STEP 90 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
fallback.example.com. IN A
SECTION ANSWER
fallback.example.com. IN A 10.3.3.4
ENTRY_END

; Test 6: Same qname answered differently in views m-a and m (Cache Isolation)
; Step 6.1: view m-a resolves shared.example.com -> 10.1.1.99
STEP 100 QUERY ADDRESS 10.10.10.10
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
shared.example.com. IN A
ENTRY_END

STEP 110 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
shared.example.com. IN A
SECTION ANSWER
shared.example.com. IN A 10.1.1.99
ENTRY_END

; Step 6.2: view m resolves same qname shared.example.com -> 10.2.2.99
STEP 120 QUERY ADDRESS 10.10.10.20
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
shared.example.com. IN A
ENTRY_END

STEP 130 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
shared.example.com. IN A
SECTION ANSWER
shared.example.com. IN A 10.2.2.99
ENTRY_END

; Step 6.3: global view resolves same qname -> 10.3.3.99
STEP 140 QUERY ADDRESS 10.10.10.50
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
shared.example.com. IN A
ENTRY_END

STEP 150 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
shared.example.com. IN A
SECTION ANSWER
shared.example.com. IN A 10.3.3.99
ENTRY_END

; Step 6.4: verify view m-a still gets 10.1.1.99 from its cache
STEP 160 QUERY ADDRESS 10.10.10.10
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
shared.example.com. IN A
ENTRY_END

STEP 170 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
shared.example.com. IN A
SECTION ANSWER
shared.example.com. IN A 10.1.1.99
ENTRY_END

; Step 6.5: verify view m still gets 10.2.2.99 from its cache
STEP 180 QUERY ADDRESS 10.10.10.20
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
shared.example.com. IN A
ENTRY_END

STEP 190 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
shared.example.com. IN A
SECTION ANSWER
shared.example.com. IN A 10.2.2.99
ENTRY_END

; Test 7: view-first: no with partial view forwarder + global root forwarder
; Step 7.1: matching zone in v-nofallback is forwarded to 216.0.0.4
STEP 200 QUERY ADDRESS 10.10.10.40
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
host.corp.example.com. IN A
ENTRY_END

STEP 210 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
host.corp.example.com. IN A
SECTION ANSWER
host.corp.example.com. IN A 10.4.4.4
ENTRY_END

; Step 7.2: non-matching zone in v-nofallback must NOT fall back to global root forwarder (uses root hints instead)
STEP 220 QUERY ADDRESS 10.10.10.40
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
fallback.example.com. IN A
ENTRY_END

STEP 230 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
fallback.example.com. IN A
SECTION ANSWER
fallback.example.com. IN A 10.5.5.5
ENTRY_END

; Test 8: Prefetch in view m-a
; Step 8.1: initial query for prefetch.example.com in view m-a (TTL 3600)
STEP 240 QUERY ADDRESS 10.10.10.10
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
prefetch.example.com. IN A
ENTRY_END

STEP 250 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
prefetch.example.com. IN A
SECTION ANSWER
prefetch.example.com. 3600 IN A 10.1.1.55
ENTRY_END

; Step 8.2: elapse time so TTL is within prefetch leeway (100 seconds remaining)
STEP 260 TIME_PASSES ELAPSE 3500

; Step 8.3: query again from view m-a; returns cached answer and triggers background prefetch to 216.0.0.1
STEP 270 QUERY ADDRESS 10.10.10.10
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
prefetch.example.com. IN A
ENTRY_END

STEP 280 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
prefetch.example.com. IN A
SECTION ANSWER
prefetch.example.com. 100 IN A 10.1.1.55
ENTRY_END

; Step 8.4: check that view m-a cache now has the prefetched answer (10.1.1.56)
STEP 290 QUERY ADDRESS 10.10.10.10
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
prefetch.example.com. IN A
ENTRY_END

STEP 300 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
prefetch.example.com. IN A
SECTION ANSWER
prefetch.example.com. 3600 IN A 10.1.1.56
ENTRY_END

; Step 8.5: check that view m did NOT have its cache polluted by view m-a prefetch
STEP 310 QUERY ADDRESS 10.10.10.20
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
prefetch.example.com. IN A
ENTRY_END

STEP 320 CHECK_ANSWER
ENTRY_BEGIN
MATCH opcode qname qtype
SECTION QUESTION
prefetch.example.com. IN A
SECTION ANSWER
prefetch.example.com. 3600 IN A 10.2.2.55
ENTRY_END

SCENARIO_END
